# Ancient Pulls production environment template
# Copy to .env.local for local work or configure these in the deployment host.
# Never commit real secret values.

# Public application identity
NEXT_PUBLIC_APP_VERSION=67.13
NEXT_PUBLIC_SITE_URL=https://www.ancientpulls.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key

# Public business and privacy details
NEXT_PUBLIC_BUSINESS_TRADING_NAME=Ancient Pulls
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=replace-with-the-full-legal-operator-name
NEXT_PUBLIC_BUSINESS_ADDRESS=replace-with-the-geographic-service-address
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=

# Commerce remains locked until this exact flag is true and every required
# legal, payment and confirmation-email value is configured.
ANCIENT_PULLS_ORDERS_OPEN=false
STRIPE_SECRET_KEY=replace-with-the-server-only-stripe-key
STRIPE_WEBHOOK_SECRET=replace-with-the-server-only-webhook-secret
RESEND_API_KEY=replace-with-the-server-only-resend-key
ANCIENT_PULLS_ORDER_EMAIL_FROM=Ancient Pulls <orders@example.com>

# Administrator access
ADMIN_EMAILS=admin@example.com
SITE_URL=https://www.ancientpulls.com

# Optional card catalogue and pricing integrations
POKEMON_TCG_API_KEY=
JUSTTCG_API_KEY=
JUSTTCG_DAILY_LIMIT=100
JUSTTCG_MIN_INTERVAL_MS=6500
GITHUB_TOKEN=

# Private preview entitlements. These compatibility names are intentionally
# retained so existing Lukas/Skye deployments do not lose access.
POCKETPULLS_LUKAS_USER_IDS=
POCKETPULLS_SKYE_USER_IDS=
POCKETPULLS_LUKAS_EMAILS=
POCKETPULLS_SKYE_EMAILS=
