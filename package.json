{
  "name": "ancient-pulls",
  "version": "0.82.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:core": "node --test scripts/core-regression.cjs",
    "test": "node --test --test-concurrency=1 scripts/core-regression.cjs scripts/astral-regression.cjs scripts/observatory-regression.cjs scripts/astra-flight-regression.cjs scripts/website-regression.cjs scripts/sanctuary-regression.cjs",
    "check:release": "node scripts/release-preflight.mjs",
    "check:release:production": "node scripts/release-preflight.mjs --production",
    "audit:performance": "node scripts/performance-budget.mjs",
    "benchmark:scanner": "node scripts/scanner-benchmark.mjs",
    "test:browser": "node scripts/browser/run.mjs",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "dotenv": "^17.4.2",
    "geist": "1.7.2",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
